# Copy to .env.local and fill in. Never commit .env.local.

NEXT_PUBLIC_SITE_URL=https://abbas.gfixdigital.com

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed to run `npm run db:migrate`, never at runtime.
# Supply the password on its own: passwords containing @ : or / break a URI.
SUPABASE_DB_PASSWORD=
# Pooler region, e.g. ap-southeast-1. Required where IPv6 is unavailable,
# because db.<ref>.supabase.co is IPv6-only. Omit to try a direct connection.
SUPABASE_DB_REGION=
# Optional full URI. Overrides the two values above.
SUPABASE_DB_URL=

# Resend — resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@gfixdigital.com
CONTACT_TO_EMAIL=abbas@gfixdigital.com
